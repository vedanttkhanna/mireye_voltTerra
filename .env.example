MIREYE_API_KEY=
MIREYE_BASE_URL=https://api.mireye.com

# Long random value, distinct from MIREYE_API_KEY. Required by protected POST routes.
OPERATION_API_KEY=

# Optional LLM provider: auto (Gemini, then Groq), gemini, or groq
LLM_PROVIDER=auto

# Gemini (free tier from https://aistudio.google.com)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_TIMEOUT_MS=90000

# Groq (https://console.groq.com/keys)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_TIMEOUT_MS=90000
GROQ_MAX_COMPLETION_TOKENS=2800
ANTHROPIC_API_KEY=

# The DOE AFDC (Alternative Fuels Data Center) API moved from developer.nrel.gov
# to developer.nlr.gov in May 2026. DEMO_KEY works for light development use;
# get a free key at https://developer.nlr.gov/signup for real sweeps.
NREL_API_KEY=DEMO_KEY
AFDC_BASE_URL=https://developer.nlr.gov

PILOT_STATE=CA
UNDERSERVED_THRESHOLD_MULTIPLIER=2.0
MAX_SWEEP_CREDITS=15000
MAX_POINT_CHECK_CREDITS=50
PORT=3000
